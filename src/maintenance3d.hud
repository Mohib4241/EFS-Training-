.s3{--hud:#46e3e8;--hud-dim:rgba(70,227,232,.3);--hud-faint:rgba(70,227,232,.12);--hud-amber:var(--orange,#ee8c45);position:relative;min-height:560px;overflow:hidden;border:1px solid var(--hud-dim);border-radius:10px;background:#050f12;color:#cfeff1;font-size:13px;line-height:1.45}
.s3-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none}
.s3-canvas:focus-visible{outline:2px solid var(--hud-amber);outline-offset:-2px}
.s3-hud{position:relative;display:grid;grid-template-columns:minmax(230px,310px) minmax(0,1fr);grid-template-rows:auto minmax(0,1fr) auto;gap:12px;min-height:560px;padding:14px;pointer-events:none}
.s3-hud>*{pointer-events:auto}
.s3 button{border:1px solid var(--hud-dim);border-radius:4px;background:rgba(5,15,18,.72);color:#cfeff1;font:inherit;padding:8px 12px;cursor:pointer}
.s3 button:hover:not(:disabled){border-color:var(--hud);background:var(--hud-faint)}
.s3 button:focus-visible{outline:2px solid var(--hud-amber);outline-offset:2px}
.s3 button:disabled{opacity:.45;cursor:default}
.s3-tabs{grid-column:1/-1;display:flex;gap:6px;flex-wrap:wrap}
.s3-tabs button[aria-selected=true]{border-color:var(--hud);background:var(--hud-faint);color:var(--hud)}
.s3-steps{grid-row:2;align-self:start;margin:0;padding:10px;list-style:none;border:1px solid var(--hud-dim);border-radius:4px;background:rgba(5,15,18,.72);max-height:100%;overflow:auto}
.s3-steps li+li{margin-top:4px}
.s3-steps button{display:block;width:100%;text-align:left;border-color:transparent;background:none}
.s3-steps .is-done button{color:var(--hud)}
.s3-steps .is-current button{border-color:var(--hud-amber);color:#ffd9b8;background:rgba(238,140,69,.1)}
.s3-title{margin:0 0 8px;color:var(--hud);font:600 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase}
.s3-bar{grid-column:1/-1;grid-row:3;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-top:10px;border-top:1px solid var(--hud-dim)}
.s3-badge{color:var(--hud);font:600 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}
.s3-status{color:#8fb3b6}
@media (max-width:720px){.s3-hud{grid-template-columns:minmax(0,1fr)}.s3-steps{grid-row:auto}}
